# Production Environment Variables
# Copy this to your deployment platform (Railway/Render)

# Django Core
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=your-secret-key-here-50-characters-minimum
DJANGO_ALLOWED_HOSTS=.railway.app,.render.com
DEBUG=False

# Database (auto-set by Railway/Render)
DATABASE_URL=postgis://user:password@host:port/dbname

# Redis (auto-set by Railway/Render)
REDIS_URL=redis://host:port/0

# CORS - Update with your actual Vercel URL
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app,https://your-app-preview.vercel.app

# Security
SECURE_SSL_REDIRECT=True

# Email (optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# Logging (optional)
LOG_FILE_PATH=/var/log/attendance/app.log

# Sentry (optional)
SENTRY_DSN=https://your-sentry-dsn
